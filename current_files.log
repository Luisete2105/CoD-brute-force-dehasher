	from core.cod_hashes import (
	    black_ops_3_scr, hash_bo4cw_scr, base_fnv1a_63, mwii_iii_scr, iw_resources,
	    base_fnv1a_32, iw_dvars, base_fnv1a_64, black_ops_6_scr, black_ops_6_sp_scr,
	    black_ops_6_omnvars
	)
